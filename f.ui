      <!-- ===================== TAB 7: LIVE (MQTT) ===================== -->
      <widget class="QWidget" name="tabLiveMode">
       <attribute name="title">
        <string>📡  Live (MQTT)</string>
       </attribute>
       <layout class="QVBoxLayout" name="verticalLayoutLiveMode">
        <item>
         <widget class="QLabel" name="labelLiveModeInfo">
          <property name="text">
           <string>Live mode streams both the Digital Twin output and the ECU output over MQTT and feeds them into the same comparison engine used for offline CSV comparison. Connect to the broker, then incoming samples populate the Preview, Statistics, and Graphs tabs in real time.</string>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QGroupBox" name="groupBoxMqttBroker">
          <property name="title">
           <string>MQTT Broker</string>
          </property>
          <layout class="QFormLayout" name="formLayoutMqttBroker">
           <item row="0" column="0">
            <widget class="QLabel" name="labelMqttHostCaption">
             <property name="text">
              <string>Broker Host / IP:</string>
             </property>
            </widget>
           </item>
           <item row="0" column="1">
            <widget class="QLineEdit" name="lineEditMqttHost">
             <property name="placeholderText">
              <string>localhost</string>
             </property>
            </widget>
           </item>
           <item row="1" column="0">
            <widget class="QLabel" name="labelMqttPortCaption">
             <property name="text">
              <string>Port:</string>
             </property>
            </widget>
           </item>
           <item row="1" column="1">
            <widget class="QSpinBox" name="spinBoxMqttPort">
             <property name="minimum">
              <number>1</number>
             </property>
             <property name="maximum">
              <number>65535</number>
             </property>
             <property name="value">
              <number>1883</number>
             </property>
            </widget>
           </item>
           <item row="2" column="0">
            <widget class="QLabel" name="labelMqttQosCaption">
             <property name="text">
              <string>QoS:</string>
             </property>
            </widget>
           </item>
           <item row="2" column="1">
            <widget class="QComboBox" name="comboBoxMqttQos">
             <item>
              <property name="text">
               <string>0 — At most once</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>1 — At least once</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>2 — Exactly once</string>
              </property>
             </item>
            </widget>
           </item>
           <item row="3" column="0">
            <widget class="QLabel" name="labelMqttUserCaption">
             <property name="text">
              <string>Username (opt.):</string>
             </property>
            </widget>
           </item>
           <item row="3" column="1">
            <widget class="QLineEdit" name="lineEditMqttUser">
             <property name="placeholderText">
              <string>(anonymous)</string>
             </property>
            </widget>
           </item>
           <item row="4" column="0">
            <widget class="QLabel" name="labelMqttPassCaption">
             <property name="text">
              <string>Password (opt.):</string>
             </property>
            </widget>
           </item>
           <item row="4" column="1">
            <widget class="QLineEdit" name="lineEditMqttPass">
             <property name="echoMode">
              <enum>QLineEdit::Password</enum>
             </property>
             <property name="placeholderText">
              <string>(none)</string>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
        <item>
         <widget class="QGroupBox" name="groupBoxMqttTopics">
          <property name="title">
           <string>MQTT Topic Roots</string>
          </property>
          <layout class="QFormLayout" name="formLayoutMqttTopics">
           <item row="0" column="0">
            <widget class="QLabel" name="labelMqttTwinTopicCaption">
             <property name="text">
              <string>Digital Twin topic:</string>
             </property>
            </widget>
           </item>
           <item row="0" column="1">
            <widget class="QLineEdit" name="lineEditMqttTwinTopic">
             <property name="text">
              <string>bms/twin/#</string>
             </property>
            </widget>
           </item>
           <item row="1" column="0">
            <widget class="QLabel" name="labelMqttEcuTopicCaption">
             <property name="text">
              <string>ECU topic:</string>
             </property>
            </widget>
           </item>
           <item row="1" column="1">
            <widget class="QLineEdit" name="lineEditMqttEcuTopic">
             <property name="text">
              <string>bms/actual/#</string>
             </property>
            </widget>
           </item>
          </layout>
</widget>
         </item>
         <item>
          <widget class="QGroupBox" name="groupBoxLiveUpdate">
           <property name="title">
            <string>Live Update</string>
           </property>
           <layout class="QFormLayout" name="formLayoutLiveUpdate">
            <item row="0" column="0" colspan="2">
             <widget class="QCheckBox" name="checkBoxLiveAutoRefresh">
              <property name="text">
               <string>Auto-refresh (re-run align + statistics on a timer)</string>
              </property>
              <property name="checked">
               <bool>true</bool>
              </property>
             </widget>
            </item>
            <item row="1" column="0">
             <widget class="QLabel" name="labelLiveIntervalCaption">
              <property name="text">
               <string>Refresh interval:</string>
              </property>
             </widget>
            </item>
            <item row="1" column="1">
             <layout class="QHBoxLayout" name="horizontalLayoutLiveInterval">
              <item>
               <widget class="QSpinBox" name="spinBoxLiveInterval">
                <property name="minimum">
                 <number>50</number>
                </property>
                <property name="maximum">
                 <number>10000</number>
                </property>
                <property name="singleStep">
                 <number>50</number>
                </property>
                <property name="value">
                 <number>500</number>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QLabel" name="labelLiveIntervalUnit">
                <property name="text">
                 <string>ms</string>
                </property>
               </widget>
              </item>
             </layout>
            </item>
           </layout>
          </widget>
         </item>
         <item>
          <layout class="QHBoxLayout" name="horizontalLayoutLiveControls">
          <item>
           <widget class="QPushButton" name="btnLiveConnect">
            <property name="minimumSize">
             <size>
              <width>0</width>
              <height>36</height>
             </size>
            </property>
            <property name="text">
             <string>Connect Live Stream</string>
            </property>
            <property name="checkable">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item>
<widget class="QLabel" name="labelLiveStatus">
             <property name="text">
              <string>Status: Disconnected</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="btnLiveFreeze">
             <property name="text">
              <string>Freeze View</string>
             </property>
             <property name="checkable">
              <bool>true</bool>
             </property>
             <property name="toolTip">
              <string>Pause the Graphs tab's auto-scrolling live window. New samples keep arriving and the curves keep updating -- only the visible time range stops sliding, so you can look at the current view without it moving. Un-freeze to jump straight back to live.</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="btnLiveSnapshot">
             <property name="text">
              <string>Take Snapshot</string>
             </property>
             <property name="toolTip">
              <string>Capture the current live data as a static comparison (like a completed offline run) so the Report/Export tab can save it to CSV/Excel/PDF/HTML. Independent of Freeze View -- taking a snapshot doesn't pause the graphs, and freezing the graphs doesn't export anything on its own.</string>
             </property>
            </widget>
           </item>
          </layout>
        </item>
        <item>
         <spacer name="verticalSpacerLiveMode">
          <property name="orientation">
           <enum>Qt::Vertical</enum>
          </property>
          <property name="sizeHint" stdset="0">
           <size>
            <width>20</width>
            <height>40</height>
           </size>
          </property>
         </spacer>
        </item>
       </layout>
      </widget>

