<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1280</width>
    <height>860</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Digital Twin Validation Tool — Twin (Simulink) vs ECU (NXP MPC5744P)</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
QMainWindow, QWidget {
    background-color: #0d0d0d;
    color: #ffffff;
    font-family: "Segoe UI", "system-ui", sans-serif;
    font-size: 10.5pt;
}

/* ---------- Tabs ---------- */
QTabWidget::pane {
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 10px;
    top: -1px;
    background: #1a1a19;
}
QTabBar::tab {
    background: transparent;
    color: #c3c2b7;
    padding: 10px 18px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-weight: 600;
}
QTabBar::tab:hover {
    color: #ffffff;
    background: #242422;
}
QTabBar::tab:selected {
    color: #ffffff;
    background: #1a1a19;
    border: 1px solid rgba(255,255,255,0.12);
    border-bottom: 3px solid #3987e5;
}

/* ---------- Group boxes (section cards) ---------- */
QGroupBox {
    background: #1a1a19;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 10px;
    margin-top: 14px;
    padding: 14px 10px 10px 10px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    top: 2px;
    padding: 0 6px;
    color: #3987e5;
}

/* ---------- Buttons ---------- */
QPushButton {
    background-color: #3987e5;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #5598e7;
}
QPushButton:pressed {
    background-color: #5598e7;
    padding-top: 9px;
}
QPushButton:disabled {
    background-color: #242422;
    color: #898781;
}

/* ---------- Inputs ---------- */
QLineEdit, QComboBox, QDoubleSpinBox, QSpinBox, QTextEdit {
    background-color: #1a1a19;
    color: #ffffff;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 6px;
    padding: 5px 8px;
    selection-background-color: #3987e5;
}
QLineEdit:focus, QComboBox:focus, QDoubleSpinBox:focus, QSpinBox:focus, QTextEdit:focus {
    border: 1px solid #3987e5;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled {
    color: #898781;
    background-color: #242422;
}
QComboBox::drop-down { border: none; width: 22px; }
QCheckBox, QLabel { color: #ffffff; }
QCheckBox::indicator {
    width: 16px; height: 16px; border-radius: 4px;
    border: 1px solid rgba(255,255,255,0.12);
    background: #1a1a19;
}
QCheckBox::indicator:checked {
    background: #3987e5;
    border: 1px solid #3987e5;
}

/* ---------- Progress bar ---------- */
QProgressBar {
    background-color: #242422;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 8px;
    height: 18px;
    text-align: center;
    color: #ffffff;
    font-weight: 600;
}
QProgressBar::chunk {
    border-radius: 7px;
    background-color: #3987e5;
}

/* ---------- Tables ---------- */
QTableView, QTableWidget {
    background-color: #1a1a19;
    alternate-background-color: #242422;
    gridline-color: #2c2c2a;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 8px;
    selection-background-color: #3987e5;
    selection-color: #ffffff;
}
QHeaderView::section {
    background-color: #242422;
    color: #c3c2b7;
    padding: 6px;
    border: none;
    border-bottom: 2px solid #3987e5;
    font-weight: 600;
}

/* ---------- Splitters / scrollbars ---------- */
QSplitter::handle {
    background: rgba(255,255,255,0.12);
}
QSplitter::handle:hover {
    background: #3987e5;
}
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: rgba(255,255,255,0.12);
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #3987e5;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
}
QScrollBar::handle:horizontal {
    background: rgba(255,255,255,0.12);
    border-radius: 5px;
    min-width: 24px;
}
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }

/* ---------- Status bar ---------- */
QStatusBar {
    background: #1a1a19;
    color: #c3c2b7;
}

/* ---------- Stat cards (summary frames) ---------- */
QFrame#frameTotalSamples, QFrame#frameMatchedSamples, QFrame#frameMAE,
QFrame#frameMaxError, QFrame#frameRMSE, QFrame#frameMatchPercentage {
    background: #1a1a19;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 10px;
    padding: 10px;
}
QFrame#frameTotalSamples { border-left: 4px solid #3987e5; }
QFrame#frameMatchedSamples { border-left: 4px solid #199e70; }
QFrame#frameMAE { border-left: 4px solid #9085e9; }
QFrame#frameMaxError { border-left: 4px solid #d95926; }
QFrame#frameRMSE { border-left: 4px solid #d55181; }
QFrame#frameMatchPercentage { border-left: 4px solid #0ca30c; }

QLabel#labelTotalSamplesTitle, QLabel#labelMatchedSamplesTitle, QLabel#labelMAETitle,
QLabel#labelMaxErrorTitle, QLabel#labelRMSETitle, QLabel#labelMatchPercentageTitle {
    color: #898781;
    font-weight: 600;
    font-size: 9pt;
}
QLabel#labelTotalSamplesValue, QLabel#labelMatchedSamplesValue, QLabel#labelMAEValue,
QLabel#labelMaxErrorValue, QLabel#labelRMSEValue, QLabel#labelMatchPercentageValue {
    font-size: 22px;
    font-weight: 700;
    color: #ffffff;
}
</string>
